# Copy to .env (gitignored) next to docker-compose.yml and fill in.
# Never commit the real .env.

# Tailscale sidecar auth key (https://login.tailscale.com/admin/settings/keys).
TS_AUTHKEY=

# Bearer token for the task API (POST/GET/PATCH /api/tasks).
# Generate with: openssl rand -hex 32
# Leave empty to keep the task API switched off (it answers 503).
TASK_API_TOKEN=

# Time zone for turning an ISO datetime (and "tomorrow" in the voice add-on)
# into a task's due date, e.g. America/Chicago. Default UTC.
TASK_TZ=

# =============================================================================
# Optional voice capture add-on (addons/voice/README.md). Everything below is
# ignored unless you enable it:
#   COMPOSE_PROFILES=voice    voice notes from the phone
#   COMPOSE_PROFILES=alexa    the same, plus Alexa through a Cloudflare Tunnel
# =============================================================================
# COMPOSE_PROFILES=voice

# Bearer token for /ingest/* (phone Shortcut, review page). openssl rand -hex 32
INGEST_API_TOKEN=

# LLM that turns transcripts into tasks: anthropic | openai | gemini | openai_compatible
EXTRACT_PROVIDER=anthropic
# Leave empty for Anthropic's default (the cheapest tier); required for the others.
EXTRACT_MODEL=
EXTRACT_API_KEY=
# Only for openai_compatible (e.g. a local Ollama: http://ollama:11434/v1)
EXTRACT_BASE_URL=

# Deepgram speech-to-text for voice notes (audio is sent to Deepgram).
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# en, or multi for mixed languages; empty = Deepgram's default
DEEPGRAM_LANGUAGE=en
# true = Deepgram keeps no audio or transcript after replying (may cost more per minute)
DEEPGRAM_MIP_OPT_OUT=true
# Seconds to wait before each retry when Deepgram is busy or down (empty = no retries).
TRANSCRIBE_RETRY_DELAYS=60,300,900
# One POST per note that failed for good, e.g. a Home Assistant webhook:
# ALERT_WEBHOOK_URL=http://host.docker.internal:8123/api/webhook/milaclone-ingest-failed
ALERT_WEBHOOK_URL=
# Link included in the alert, e.g. https://mila.<tailnet>.ts.net/ingest/review
INGEST_REVIEW_URL=

# Alexa (addons/voice/docs/alexa.md), with COMPOSE_PROFILES=alexa.
# The tunnel's token from the Cloudflare dashboard (Networks > Tunnels).
CLOUDFLARE_TUNNEL_TOKEN=
