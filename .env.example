# Copy to .env (gitignored) next to docker-compose.yml and fill in.
# Never commit the real .env.

# Tailscale sidecar auth key (https://login.tailscale.com/admin/settings/keys).
TS_AUTHKEY=

# Bearer token for the task API (POST/GET/PATCH /api/tasks).
# Generate with: openssl rand -hex 32
# Leave empty to keep the task API switched off (it answers 503).
TASK_API_TOKEN=

# Time zone for turning an ISO datetime into a task's due date.
TASK_TZ=America/Chicago

# ---- Voice pipeline (docs/voice-capture.md) ----
# Bearer token for /ingest/* (phone Shortcut, review page). openssl rand -hex 32
INGEST_API_TOKEN=

# LLM that turns transcripts into tasks: anthropic | openai | gemini | openai_compatible
EXTRACT_PROVIDER=anthropic
# Leave empty for Anthropic's default (the cheapest tier); required for the others.
EXTRACT_MODEL=
EXTRACT_API_KEY=
# Only for openai_compatible (e.g. a local Ollama: http://ollama:11434/v1)
EXTRACT_BASE_URL=

# Whisper speech-to-text on the CPU: tiny | base | small
WHISPER_MODEL=base
WHISPER_THREADS=2
# e.g. en to skip language detection; empty = detect
WHISPER_LANGUAGE=
