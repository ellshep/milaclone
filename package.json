{
  "name": "canvas-board",
  "version": "1.0.0",
  "description": "A self-hosted visual board / Milanote-style workspace",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "test": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 \"test/*.test.js\"",
    "test:ui": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-highlight": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "better-sqlite3": "^13.0.1",
    "esbuild": "0.28.2",
    "express": "4.22.3",
    "multer": "2.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "body-parser": "1.20.8",
    "proxy-addr": "2.0.8",
    "qs": "6.16.0"
  }
}
