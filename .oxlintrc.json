{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": { "node": true, "es2024": true },
  "ignorePatterns": [".claude/**", "public/vendor/**", "coverage/**", "playwright-report/**"],
  "rules": {
    "no-undef": "error",
    "max-lines": ["error", { "max": 400, "skipBlankLines": true, "skipComments": true }]
  },
  "overrides": [
    {
      "files": ["public/js/**"],
      "env": { "browser": true, "node": false },
      "globals": { "lucide": "readonly" }
    },
    {
      "files": ["addons/agent/public/**"],
      "env": { "browser": true, "node": false }
    },
    {
      "files": ["public/sw.js"],
      "env": { "serviceworker": true, "node": false }
    },
    {
      "files": ["e2e/**", "test/**"],
      "env": { "browser": true }
    },
    {
      "files": ["public/js/quicknotes.js"],
      "rules": { "max-lines": ["error", { "max": 1029, "skipBlankLines": true, "skipComments": true }] }
    },
    {
      "files": ["public/js/cards.js"],
      "rules": { "max-lines": ["error", { "max": 863, "skipBlankLines": true, "skipComments": true }] }
    },
    {
      "files": ["routes.js"],
      "rules": { "max-lines": ["error", { "max": 510, "skipBlankLines": true, "skipComments": true }] }
    },
    {
      "files": ["test/api.test.js"],
      "rules": { "max-lines": ["error", { "max": 1095, "skipBlankLines": true, "skipComments": true }] }
    },
    {
      "files": ["test/tasks.api.test.js"],
      "rules": { "max-lines": ["error", { "max": 463, "skipBlankLines": true, "skipComments": true }] }
    },
    {
      "files": ["addons/mcp/test/mcp.test.js"],
      "rules": { "max-lines": ["error", { "max": 427, "skipBlankLines": true, "skipComments": true }] }
    }
  ]
}
